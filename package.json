{
  "name": "ets2-package-sync",
  "productName": "ETS2 Package Sync",
  "version": "2.1.0",
  "description": "Sync ETS2 dedicated server packages through GitHub",
  "author": "ETS2 Package Sync",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:renderer": "vite build",
    "start": "npm run build:renderer && electron .",
    "dist": "npm run build:renderer && electron-builder --win --publish never",
    "release": "npm run build:renderer && electron-builder --win --publish always",
    "postinstall": "node node_modules/electron/install.js"
  },
  "build": {
    "appId": "com.ets2.packagesync",
    "productName": "ETS2 Package Sync",
    "artifactName": "ETS2PackageSync-Portable-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "electron/**/*",
      "out/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "icons",
        "filter": [
          "tray-*.png",
          "icon.png",
          "icon.ico"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "xSpartan155x",
        "repo": "ets-server-updater",
        "releaseType": "draft"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "artifactName": "ETS2PackageSync-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ETS2 Package Sync",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
